    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Cari lokasi...">
        <button onclick="searchLocation()">🔍 Cari</button>
    </div>

    <div id="map" style="height: 500px;"></div>

    <div class="legend">
        <div class="legend-item free">🟢 Gratis</div>
        <div class="legend-item paid">🟡 Berbayar</div>
        <div class="legend-item fast">🔵 Cepat (>50Mbps)</div>
    </div>

    <button class="add-wifi" onclick="showAddForm()">➕ Tambah WiFi</button>

    <!-- Form Tambah WiFi -->
    <div id="addForm" class="modal" style="display:none;">
        <div class="modal-content">
            <span class="close" onclick="hideAddForm()">&times;</span>
            <h3>Tambah Hotspot WiFi</h3>
            <input type="text" id="wifiName" placeholder="Nama WiFi">
            <input type="text" id="wifiPassword" placeholder="Password (kosongkan jika gratis)">
            <select id="wifiType">
                <option value="free">Gratis</option>
                <option value="paid">Berbayar</option>
                <option value="fast">Cepat</option>
            </select>
            <button onclick="addWiFi()">Simpan</button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="script.js"></script>
